{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Home-region DNS blocklist synchronization using a precompiled C# worker.",
  "Parameters": {
    "TableName": {
      "Type": "String"
    },
    "WorkerArtifactBucket": {
      "Type": "String"
    },
    "WorkerArtifactKey": {
      "Type": "String"
    },
    "WorkerArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "WorkerArtifactSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "ArtifactKeyArn": {
      "Type": "String",
      "Description": "KMS key encrypting the deployment artifact bucket."
    },
    "BlocklistProfile": {
      "Type": "String",
      "Default": "Balanced",
      "AllowedValues": [
        "Light",
        "Balanced",
        "Strict"
      ]
    },
    "SyncSchedule": {
      "Type": "String",
      "Default": "rate(8 hours)"
    },
    "SyncEnabled": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "WorkerMode": {
      "Type": "String",
      "Default": "sync",
      "AllowedValues": [
        "validate",
        "sync"
      ]
    },
    "OperationalLogRetentionDays": {
      "Type": "Number",
      "Default": 30,
      "AllowedValues": [
        1,
        3,
        5,
        7,
        14,
        30,
        60,
        90,
        120,
        150,
        180,
        365
      ]
    },
    "NotificationTopicArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional SNS destination for sync alarms."
    }
  },
  "Conditions": {
    "ScheduleEnabled": {
      "Fn::Equals": [
        {
          "Ref": "SyncEnabled"
        },
        "true"
      ]
    },
    "HasNotificationTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "NotificationTopicArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "SyncKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "logs.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": [
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:DescribeKey"
              ],
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "kms:EncryptionContext:aws:logs:arn": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/codebuild/${AWS::StackName}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "SyncLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/codebuild/${AWS::StackName}"
        },
        "KmsKeyId": {
          "Fn::GetAtt": [
            "SyncKey",
            "Arn"
          ]
        },
        "RetentionInDays": {
          "Ref": "OperationalLogRetentionDays"
        }
      }
    },
    "SyncRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "SyncPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "BlocklistSync",
        "Roles": [
          {
            "Ref": "SyncRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:UpdateItem",
                "dynamodb:PutItem",
                "dynamodb:DeleteItem",
                "dynamodb:Scan",
                "dynamodb:Query"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TableName}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TableName}/index/ManagedRecords"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObjectVersion"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${WorkerArtifactBucket}/${WorkerArtifactKey}"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey",
                "kms:DescribeKey"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "SyncKey",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt"
              ],
              "Resource": {
                "Ref": "ArtifactKeyArn"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "SyncLogGroup",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "SyncProject": {
      "Type": "AWS::CodeBuild::Project",
      "DependsOn": [
        "SyncPolicy"
      ],
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "ServiceRole": {
          "Fn::GetAtt": [
            "SyncRole",
            "Arn"
          ]
        },
        "EncryptionKey": {
          "Fn::GetAtt": [
            "SyncKey",
            "Arn"
          ]
        },
        "ConcurrentBuildLimit": 1,
        "TimeoutInMinutes": 60,
        "QueuedTimeoutInMinutes": 60,
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Cache": {
          "Type": "LOCAL",
          "Modes": [
            "LOCAL_SOURCE_CACHE",
            "LOCAL_CUSTOM_CACHE"
          ]
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": false,
          "EnvironmentVariables": [
            {
              "Name": "TABLE_NAME",
              "Value": {
                "Ref": "TableName"
              }
            },
            {
              "Name": "BLOCKLIST_PROFILE",
              "Value": {
                "Ref": "BlocklistProfile"
              }
            },
            {
              "Name": "WORKER_MODE",
              "Value": {
                "Ref": "WorkerMode"
              }
            },
            {
              "Name": "CACHE_DIRECTORY",
              "Value": "/root/dns-sync-cache"
            },
            {
              "Name": "ARTIFACT_BUCKET",
              "Value": {
                "Ref": "WorkerArtifactBucket"
              }
            },
            {
              "Name": "ARTIFACT_KEY",
              "Value": {
                "Ref": "WorkerArtifactKey"
              }
            },
            {
              "Name": "ARTIFACT_VERSION",
              "Value": {
                "Ref": "WorkerArtifactVersion"
              }
            },
            {
              "Name": "ARTIFACT_SHA256",
              "Value": {
                "Ref": "WorkerArtifactSha256"
              }
            }
          ]
        },
        "Source": {
          "Type": "GITHUB",
          "Location": "https://github.com/hagezi/dns-blocklists.git",
          "GitCloneDepth": 0,
          "BuildSpec": "version: 0.2\nphases:\n  build:\n    commands:\n      - aws s3api get-object --bucket \"$ARTIFACT_BUCKET\" --key \"$ARTIFACT_KEY\" --version-id \"$ARTIFACT_VERSION\" /tmp/worker.tar.gz\n      - echo \"$ARTIFACT_SHA256  /tmp/worker.tar.gz\" | sha256sum --check --strict\n      - mkdir -p /tmp/dns-worker\n      - tar -xzf /tmp/worker.tar.gz -C /tmp/dns-worker\n      - chmod +x /tmp/dns-worker/dns-blocklist-sync\n      - /tmp/dns-worker/dns-blocklist-sync\ncache:\n  paths:\n    - '/root/dns-sync-cache/**/*'\n"
        },
        "SourceVersion": "main",
        "SecondarySources": [
          {
            "Type": "GITHUB",
            "Location": "https://github.com/firehol/blocklist-ipsets.git",
            "SourceIdentifier": "Firehol",
            "GitCloneDepth": 0
          }
        ],
        "SecondarySourceVersions": [
          {
            "SourceIdentifier": "Firehol",
            "SourceVersion": "master"
          }
        ],
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "SyncLogGroup"
            }
          }
        }
      }
    },
    "SchedulerDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/default"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "SchedulerPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "StartBlocklistSync",
        "Roles": [
          {
            "Ref": "SchedulerRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "codebuild:StartBuild",
              "Resource": {
                "Fn::GetAtt": [
                  "SyncProject",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "SchedulerDeadLetterQueue",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "SyncScheduledTrigger": {
      "Type": "AWS::Scheduler::Schedule",
      "DependsOn": "SchedulerPolicy",
      "Properties": {
        "ScheduleExpression": {
          "Ref": "SyncSchedule"
        },
        "State": {
          "Fn::If": [
            "ScheduleEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:codebuild:startBuild"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"ProjectName\":\"${SyncProject}\"}"
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 2
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "SchedulerDeadLetterQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "SyncFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Blocklist synchronization build failed",
        "Namespace": "AWS/CodeBuild",
        "MetricName": "FailedBuilds",
        "Dimensions": [
          {
            "Name": "ProjectName",
            "Value": {
              "Ref": "SyncProject"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 3600,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasNotificationTopic",
            [
              {
                "Ref": "NotificationTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "SyncStaleAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "ScheduleEnabled",
      "Properties": {
        "AlarmDescription": "No successful blocklist synchronization for three hours",
        "Namespace": "DnsFilter/Sync",
        "MetricName": "Success",
        "Dimensions": [
          {
            "Name": "Profile",
            "Value": {
              "Ref": "BlocklistProfile"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 3600,
        "EvaluationPeriods": 3,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": {
          "Fn::If": [
            "HasNotificationTopic",
            [
              {
                "Ref": "NotificationTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "SyncDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "DashboardBody": {
          "Fn::Sub": "{\"widgets\": [{\"type\": \"metric\", \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Blocklist builds\", \"region\": \"${AWS::Region}\", \"stat\": \"Sum\", \"period\": 3600, \"metrics\": [[\"AWS/CodeBuild\", \"SucceededBuilds\", \"ProjectName\", \"${SyncProject}\"], [\"AWS/CodeBuild\", \"FailedBuilds\", \"ProjectName\", \"${SyncProject}\"]]}}, {\"type\": \"metric\", \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Sync duration\", \"region\": \"${AWS::Region}\", \"stat\": \"Average\", \"period\": 3600, \"metrics\": [[\"AWS/CodeBuild\", \"Duration\", \"ProjectName\", \"${SyncProject}\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 6, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Incremental changes and protected customer records\", \"region\": \"${AWS::Region}\", \"stat\": \"Sum\", \"period\": 3600, \"metrics\": [[\"DnsFilter/Sync\", \"Added\", \"Profile\", \"${BlocklistProfile}\"], [\"DnsFilter/Sync\", \"Removed\", \"Profile\", \"${BlocklistProfile}\"], [\"DnsFilter/Sync\", \"ProtectedConflicts\", \"Profile\", \"${BlocklistProfile}\"], [\"DnsFilter/Sync\", \"Success\", \"Profile\", \"${BlocklistProfile}\"]]}}]}"
        }
      }
    }
  },
  "Outputs": {
    "BuildProject": {
      "Value": {
        "Ref": "SyncProject"
      }
    },
    "BuildProjectArn": {
      "Value": {
        "Fn::GetAtt": [
          "SyncProject",
          "Arn"
        ]
      }
    }
  }
}
